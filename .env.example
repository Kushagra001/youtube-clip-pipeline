# ==============================================================================
# YouTube Clipping Pipeline Environment Variables
# Copy this file to `.env` and fill in your values
# ==============================================================================

# (Optional) Groq API Key for AI highlight selection & niche expansion
GROQ_API_KEY=

# YouTube Data API v3 OAuth Credentials
# Generated via Google Cloud Console (Desktop App Client ID)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Default fallback refresh token
YOUTUBE_REFRESH_TOKEN=

# Per-Channel OAuth Refresh Tokens
# Generate via: `python pipeline/get_youtube_token.py --channel acc_01_cats`, etc.
YOUTUBE_REFRESH_TOKEN_ACC_01=
YOUTUBE_REFRESH_TOKEN_ACC_02=
YOUTUBE_REFRESH_TOKEN_ACC_03=
YOUTUBE_REFRESH_TOKEN_ACC_04=
YOUTUBE_REFRESH_TOKEN_ACC_05=
YOUTUBE_REFRESH_TOKEN_ACC_06=
YOUTUBE_REFRESH_TOKEN_ACC_07=
YOUTUBE_REFRESH_TOKEN_ACC_08=
YOUTUBE_REFRESH_TOKEN_ACC_09=
YOUTUBE_REFRESH_TOKEN_ACC_10=
